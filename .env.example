# TerraWatch Environment Configuration (copy to .env and fill in real values — keep .env out of git)

# Power: Meterless Nightshift Runtime (primary route; URL+token come from Nightshift's Console)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Power fallback: direct NVIDIA API route (build.nvidia.com). Only used when Meterless is unset.
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=your-nvapi-key
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional secondary fallback (needs the langchain-groq package)
GROQ_API_KEY=

# Data: Zetaris Platform REST API
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-password

# Investigation source keys (live mode; optional per source)
OPENAQ_API_KEY=
FIRMS_MAP_KEY=
GEOAPIFY_API_KEY=

# Feature switches
TERRAWATCH_MODE=live
# TERRAWATCH_MEMORY=0            # disable H-MEM investigation memory
# TERRAWATCH_MEMORY_DB=path.db   # override memory sqlite location
# TERRAWATCH_LLM_MODEL=openai/gpt-oss-20b  # Groq fallback model id
